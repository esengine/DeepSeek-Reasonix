{
  "mcpServers": {
    "cognee": {
      "type": "http",
      "url": "http://127.0.0.1:12316/mcp-new"
    },
    "chrome": {
      "command": "node",
      "args": [
        "${REASONIX_MCP_BRIDGE:-mcp-bridge.js}",
        "--server"
      ],
      "env": {
        "MCP_SERVER_URL": "http://127.0.0.1:12306/mcp-new",
        "MCP_PROTOCOL_MODE": "stateless",
        "MCP_PROTOCOL_VERSION": "2026-07-28",
        "MCP_SERVER_ORIGIN": "http://127.0.0.1",
        "CHROME_MCP_API_KEY": ""
      }
    }
  }
}
