---
interface Props {
  id: string;
  name?: string;
  autocomplete: string;
  minlength?: number;
  required?: boolean;
}

const { id, name, autocomplete, minlength, required = false } = Astro.props;
---

<div class="password-input">
  <input
    id={id}
    name={name}
    type="password"
    autocomplete={autocomplete}
    minlength={minlength}
    required={required}
  />
  <button
    type="button"
    class="password-toggle"
    data-password-toggle
    aria-controls={id}
    aria-pressed="false"
    aria-label="Show password / 显示密码">
    <svg class="password-eye-open" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
      <circle cx="12" cy="12" r="2.7" />
    </svg>
    <svg class="password-eye-closed" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 3l18 18M10.6 6.2A10.9 10.9 0 0 1 12 6c6 0 9.5 6 9.5 6a17 17 0 0 1-2.1 2.7M6.2 6.2C3.8 7.8 2.5 12 2.5 12s3.5 6 9.5 6a9.8 9.8 0 0 0 3.2-.5M9.9 9.9a3 3 0 0 0 4.2 4.2" />
    </svg>
  </button>
</div>
