---
import Base from '../layouts/Base.astro';
import CommunityJoin from '../components/CommunityJoin.astro';
import SiteHeader from '../components/SiteHeader.astro';
import community from '../data/community.json';
import { desktopDownloadVersion } from '../data/desktop-download.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/esengine/DeepSeek-Reasonix';
const repoReleases = `${repo}/releases`;
const studioReleases = `${repoReleases}?q=studio-v`;
const desktopStableFallback = desktopDownloadVersion
  ? `${repoReleases}/tag/desktop-${desktopDownloadVersion}` : repoReleases;
const desktopVersionLabel = desktopDownloadVersion || 'latest';
const desktopNotes = desktopDownloadVersion
  ? `${base}/changelog/${desktopDownloadVersion}/` : `${base}/changelog/`;
const vscodeMarketplace = 'https://marketplace.visualstudio.com/items?itemName=SivanLiu.reasonix-agent';
const openVsx = 'https://open-vsx.org/extension/SivanLiu/reasonix-agent';
const vscodeExtensionRepo = 'https://github.com/SivanCola/reasonix-vscode';

const goVer = 'latest';

const fmtN = (n) => Number(n).toLocaleString('en-US');
const avClass = (i) => 'av' + (i % 5 === 2 ? ' sm' : i % 7 === 3 ? ' lg' : '');
const half = Math.ceil(community.list.length / 2);
const rowA = community.list.slice(0, half);
const rowB = community.list.slice(half);

const desc = "Open-source AI coding assistant. The program runs on your computer and uses the model account you configure. Describe a task; it reads your project, edits files and runs commands. You decide how much it does alone, and can rewind files it changed. Use it as a desktop app, in the terminal, in the browser or in your editor. MIT.";
const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Reasonix',
  description: desc,
  url: 'https://reasonix.io/',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Windows, Linux',
  license: `${repo}/blob/main-v2/LICENSE`,
  downloadUrl: `${repo}/releases`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<Base
  title="Reasonix — an AI coding assistant you stay in control of"
  titleEn="Reasonix — an AI coding assistant you stay in control of"
  titleZh="Reasonix — 放权多少你来定的 AI 编程助手"
  description={desc}>

  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" is:inline />

  <SiteHeader />

  <main>
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow reveal"><span class="dot"></span><span class="l-en">Open source · MIT · runs on your computer, with your own model account</span><span class="l-zh">开源 · MIT · 程序在你电脑上运行，用你自己的模型账号</span></div>
      <h1 class="reveal" style="--d:0.06s">
        <span class="l-en">An AI coding assistant<br />that <span class="tt">you control</span>,<br />and can rewind.</span>
        <span class="l-zh">帮你写代码的 AI 助手：<br /><span class="tt">放权多少你来定</span>，<br />改错能撤回。</span>
      </h1>
      <p class="sub reveal" style="--d:0.12s">
        <span class="l-en">Tell it what you want. It reads your project, edits files and runs commands. Have it ask before every step, or let it act on its own within set limits. Files it changed can be rewound to how they were.</span>
        <span class="l-zh">告诉它要做什么，它会读你的项目、改文件、运行命令。你可以让它每一步都先问你，也可以让它在限定范围内自己做；改错的文件，可以退回到之前的样子。</span>
      </p>
      <div class="hero-install reveal" style="--d:0.18s" aria-label="Reasonix install options">
        <div class="install-option install-option--desktop">
          <canvas class="particle-canvas"></canvas>
          <span class="install-kicker"><span class="l-en">Reasonix Studio · recommended</span><span class="l-zh">Reasonix Studio · 推荐</span></span>
          <strong><span class="l-en">The desktop app. The easiest place to start.</span><span class="l-zh">桌面应用，图形界面，第一次用推荐从这里开始。</span></strong>
          <a class="btn btn-dark" data-os-dl data-goto="studio" href="#start"><span class="l-en">Download Studio<span class="os-for" hidden> for <span class="os-name"></span></span></span><span class="l-zh">下载 Studio<span class="os-for" hidden>（<span class="os-name"></span>）</span></span></a>
        </div>
        <div class="install-option install-option--cli">
          <canvas class="particle-canvas"></canvas>
          <span class="install-kicker"><span class="l-en">Command line (<span class="keep-case">2.x</span>)</span><span class="l-zh">命令行（<span class="keep-case">2.x</span>）</span></span>
          <strong><span class="l-en">For the terminal, on the same 2.x line as Studio.</span><span class="l-zh">在终端里使用，与 Studio 同属 2.x 版本线。</span></strong>
          <span class="install"><span class="ps1">$</span><span class="install-command">npm i -g reasonix</span><button data-copy="npm i -g reasonix">Copy</button></span>
        </div>
      </div>
      <nav class="also reveal" style="--d:0.22s" aria-label="More ways to use Reasonix / 更多使用方式">
        <span class="l-en also-row">
          <strong class="also-label">More ways to use Reasonix:</strong>
          <span class="also-links">
            <a href={`${base}/remote/`}>Web Studio</a>
            <span class="also-sep" aria-hidden="true">·</span>
            <a href="?download=vscode#start" data-goto="vscode">Editor extension</a>
            <span class="also-sep" aria-hidden="true">·</span>
            <a href="#start" data-goto="brew">Homebrew</a>
            <span class="also-sep" aria-hidden="true">·</span>
            <span>Local Web UI: <code>reasonix serve</code></span>
            <span class="also-sep" aria-hidden="true">·</span>
            <a href={`${base}/docs/#acp`}>ACP editor integration (other editors)</a>
          </span>
        </span>
        <span class="l-zh also-row">
          <strong class="also-label">更多使用方式：</strong>
          <span class="also-links">
            <a href={`${base}/remote/`}>网页版 Studio</a>
            <span class="also-sep" aria-hidden="true">·</span>
            <a href="?download=vscode#start" data-goto="vscode">编辑器扩展</a>
            <span class="also-sep" aria-hidden="true">·</span>
            <a href="#start" data-goto="brew">Homebrew</a>
            <span class="also-sep" aria-hidden="true">·</span>
            <span>本地 Web UI：<code>reasonix serve</code></span>
            <span class="also-sep" aria-hidden="true">·</span>
            <a href={`${base}/docs/#acp`}>ACP 编辑器接入（其他编辑器）</a>
          </span>
        </span>
      </nav>

      <div class="term-stage reveal" style="--d:0.26s">
        <div class="fig"><span class="l-en">fig. 01 — one task, start to finish</span><span class="l-zh">图 01 —— 一个任务,从开始到结束</span></div>
        <div class="term">
          <div class="term-bar"><i></i><i></i><i></i><span class="title">~/app — reasonix</span></div>
          <div class="term-body"><span class="tl"><span class="t-acc">◆</span> reasonix <span class="t-dim"><span class="rxv">{goVer}</span> · deepseek-v4-flash · ~/app</span></span><span class="tl"><span class="t-vio">›</span> add retry with backoff to the http client</span><span class="tl"><span class="t-acc">◇</span> plan <span class="t-dim">3 steps · 2 files · 1 test run</span></span><span class="tl"><span class="t-warm">●</span> allow <span class="t-dim">edit internal/net/client.go</span>  <span class="t-ok">yes</span></span><span class="tl"><span class="t-ok">✓</span> edit <span class="t-dim">internal/net/client.go</span>  <span class="t-add">+24 −3</span></span><span class="tl"><span class="t-ok">✓</span> edit <span class="t-dim">internal/net/client_test.go</span>  <span class="t-add">+41 −0</span></span><span class="tl"><span class="t-ok">✓</span> run <span class="t-dim">go test ./internal/net/</span>  <span class="t-ok">ok</span> <span class="t-dim">(0.21s)</span></span><span class="tl"><span class="t-acc">◆</span> checkpoint <span class="t-dim">#14 — revert this turn anytime</span></span><span class="tl"><span class="t-vio">›</span> <span class="caret"></span></span></div>
          <div class="term-stat"><span>surface <b>cli</b></span><span>tools <b data-cnt="9" data-suf=" calls">9 calls</b></span><span>session <b data-cnt="18" data-suf="m">18m</b></span><span>cost <b data-cnt="0.043" data-dec="3" data-pre="$">$0.043</b></span></div>
        </div>
      </div>
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <div class="sec-head split reveal">
        <span class="kicker"><span class="l-en">Features</span><span class="l-zh">特性</span></span>
        <h2><span class="l-en">You decide how much it does <span class="em">on its own.</span></span><span class="l-zh">它能自己做多少，<span class="em">由你来定。</span></span></h2>
        <p><span class="l-en">Handing work to an AI is only comfortable if you can see what it did and take back what you do not want. These are the controls for that.</span><span class="l-zh">把活交给 AI，前提是你能看清它做了什么，并撤回不想要的部分。下面是为此准备的几项控制。</span></p>
      </div>
      <div class="feat-grid">
        <div class="feat reveal">
          <span class="tag">01 / permissions</span>
          <h3><span class="l-en">You choose when it asks</span><span class="l-zh">什么时候问你，你来选</span></h3>
          <p><span class="l-en">Be asked before every write and command, or let everyday actions run on their own. Rules you set to forbid something always hold. On macOS and Linux, commands also run in a sandbox that limits where they can write.</span><span class="l-zh">可以每次写文件、运行命令都先问你，也可以让日常操作自动放行；你设的禁止规则始终生效。在 macOS 和 Linux 上，命令还运行在沙箱里，写入范围受限。</span></p>
          <code class="feat-chip">$ allow edit internal/net/client.go? [y/n/always]</code>
        </div>
        <div class="feat reveal" style="--d:0.06s">
          <span class="tag">02 / checkpoints</span>
          <h3><span class="l-en">Rewind its file edits</span><span class="l-zh">改错的文件能退回</span></h3>
          <p><span class="l-en">It snapshots a file before changing it, outside git, so you can rewind by conversation turn without touching your commit history. Snapshots cover files changed by its edit tools, not what a shell command did.</span><span class="l-zh">它改文件之前先留一份快照（不走 git），可按对话轮次退回，不动你的提交历史。快照只覆盖它用编辑工具改的文件，不包括命令行命令造成的改动。</span></p>
        </div>
        <div class="feat reveal" style="--d:0.04s">
          <span class="tag">03 / plan mode</span>
          <h3><span class="l-en">See the plan first</span><span class="l-zh">先看计划，再动手</span></h3>
          <p><span class="l-en">In plan mode it drafts a plan and waits. It starts the work only after you approve.</span><span class="l-zh">计划模式下，它先写出计划并等你；你批准之后才开始动手。</span></p>
        </div>
        <div class="feat reveal" style="--d:0.1s">
          <span class="tag">04 / mcp + skills</span>
          <h3><span class="l-en">Add more tools</span><span class="l-zh">可以接入更多工具</span></h3>
          <p><span class="l-en">Connect outside tools through MCP, a common plug-in standard. Add your own skills as Markdown files, and hand side tasks such as research or review to helper agents.</span><span class="l-zh">通过 MCP（常见的工具接入标准）接入外部工具；用 Markdown 文件添加自己的技能，也可以把调研、审查之类的支线任务交给辅助智能体。</span></p>
          <code class="feat-chip">$ reasonix mcp add · ~/.reasonix/skills/</code>
        </div>
        <div class="feat reveal" style="--d:0.06s">
          <span class="tag">05 / single binary</span>
          <h3><span class="l-en">Nothing else to install</span><span class="l-zh">不用另外装环境</span></h3>
          <p><span class="l-en">The command-line tool is a single self-contained program for macOS, Linux and Windows, on Intel/AMD and ARM chips.</span><span class="l-zh">命令行版是一个自包含的程序，支持 macOS、Linux、Windows，Intel/AMD 与 ARM 芯片均可。</span></p>
        </div>
        <div class="feat reveal" style="--d:0.1s">
          <span class="tag">06 / local-first</span>
          <h3><span class="l-en">Your key, your model account</span><span class="l-zh">你的密钥，你的模型账号</span></h3>
          <p><span class="l-en">Bring your own model key; DeepSeek is built in, and other OpenAI-compatible services work too. The program runs on your computer; your prompts and the files it reads go to the model service you set up, unless you point it at a local model. MIT licensed, developed in public.</span><span class="l-zh">自带模型密钥：内置 DeepSeek，其他兼容 OpenAI 接口的服务也能用。程序在你的电脑上运行；你的提示词和它读到的文件会发给你配置的模型服务，除非你接的是本地模型。MIT 许可，公开开发。</span></p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider" aria-hidden="true"><span class="line"></span></div>

  <section id="surfaces">
    <div class="wrap">
      <div class="sec-head split reveal">
        <span class="kicker"><span class="l-en">Surfaces</span><span class="l-zh">使用形态</span></span>
        <h2><span class="l-en">Four ways to use it. <span class="em">Pick your habit.</span></span><span class="l-zh">四种用法，<span class="em">按你的习惯选。</span></span></h2>
        <p><span class="l-en">Four ways to use Reasonix, all running the same program. Studio and the command line are both on the 2.x line; the 1.x desktop app is the previous line.</span><span class="l-zh">四种使用 Reasonix 的方式，运行的是同一套程序。Studio 与命令行同属 2.x 版本线；1.x 桌面端是上一代版本线。</span></p>
      </div>
      <div class="surf-grid">
        <div class="surf reveal">
          <div class="surf-art" aria-hidden="true">
            <span class="surf-win app">
              <i class="bar"></i>
              <span class="body"><span class="side"><i></i><i></i><i></i></span><span class="main"><i class="l" style="--w:80%"></i><i class="l" style="--w:55%"></i><i class="l ok" style="--w:66%"></i></span></span>
            </span>
          </div>
          <h3><span class="l-en">Desktop app · Studio</span><span class="l-zh">桌面端 · Studio</span></h3>
          <p><span class="l-en">A graphical app: several sessions side by side, approvals, settings, auto-update.</span><span class="l-zh">图形界面：多个会话并列、确认操作、设置、自动更新。</span></p>
          <code><span class="l-en">macOS (Apple Silicon, Intel) · Windows x64 · Linux amd64 (.deb)</span><span class="l-zh">macOS（Apple Silicon、Intel）· Windows x64 · Linux amd64（.deb）</span></code>
        </div>
        <div class="surf reveal" style="--d:0.06s">
          <div class="surf-art" aria-hidden="true">
            <span class="surf-win cli">
              <i class="bar"></i>
              <span class="body"><i class="l" style="--w:62%"></i><i class="l" style="--w:44%"></i><i class="l ok" style="--w:70%"></i><i class="l" style="--w:38%"></i><i class="cur"></i></span>
            </span>
          </div>
          <h3><span class="l-en">Terminal · 2.x</span><span class="l-zh">终端 · 2.x</span></h3>
          <p><span class="l-en">A full-screen text interface: review changes, approve actions, use slash commands.</span><span class="l-zh">全屏文字界面：查看改动、确认操作、使用斜杠命令。</span></p>
          <code>reasonix</code>
        </div>
        <div class="surf reveal" style="--d:0.12s">
          <div class="surf-art" aria-hidden="true">
            <span class="surf-win web">
              <i class="bar url"></i>
              <span class="body"><i class="l" style="--w:72%"></i><i class="l" style="--w:48%"></i><i class="l ok" style="--w:60%"></i><i class="l" style="--w:36%"></i></span>
            </span>
          </div>
          <h3><span class="l-en">Browser</span><span class="l-zh">浏览器</span></h3>
          <p><span class="l-en">A web page served from your own machine. Turn on a password or token before sharing it.</span><span class="l-zh">在你自己的机器上提供的网页界面。分享给别人之前，先开启密码或令牌。</span></p>
          <code>reasonix serve</code>
        </div>
        <div class="surf reveal" style="--d:0.18s">
          <div class="surf-art" aria-hidden="true">
            <span class="surf-win ide">
              <i class="bar"></i>
              <span class="body"><span class="tree"><i></i><i></i><i></i><i></i></span><span class="main"><i class="l" style="--w:70%"></i><i class="l add" style="--w:52%"></i><i class="l add" style="--w:44%"></i><i class="l" style="--w:64%"></i></span></span>
            </span>
          </div>
          <h3><span class="l-en">Your editor</span><span class="l-zh">你的编辑器</span></h3>
          <p><span class="l-en">VS Code and VSCodium via the extension. Other editors that support ACP (Agent Client Protocol, a common way for editors to connect to an AI assistant) can connect too.</span><span class="l-zh">VS Code 与 VSCodium 装扩展即可。其他支持 ACP（编辑器接入 AI 助手的通用约定）的编辑器也可以连接。</span></p>
          <code>reasonix acp</code>
        </div>
      </div>
    </div>
  </section>

  <div class="divider" aria-hidden="true"><span class="line"></span></div>

  <section>
    <div class="wrap">
      <div class="steps">
        <div class="step reveal">
          <span class="num">01</span>
          <h3><span class="l-en">Install</span><span class="l-zh">安装</span></h3>
          <p><span class="l-en">Download Reasonix Studio for macOS, Windows, or Linux — or use the 2.x command line:</span><span class="l-zh">下载 macOS、Windows 或 Linux 版 Reasonix Studio，或使用 2.x 命令行：</span></p>
          <code>npm i -g reasonix</code>
          <a class="step-link" href="#start" data-goto="studio"><span class="l-en">Get Studio →</span><span class="l-zh">获取 Studio →</span></a>
        </div>
        <div class="step reveal" style="--d:0.08s">
          <span class="num">02</span>
          <h3><span class="l-en">Open your project</span><span class="l-zh">打开你的项目</span></h3>
          <p><span class="l-en">Open a project folder in Studio, or run it from a terminal inside the folder. Then write what you want done.</span><span class="l-zh">在 Studio 里打开项目文件夹，或在终端里进入该文件夹运行。然后写下你想做的事。</span></p>
          <code>cd your-project &amp;&amp; reasonix</code>
        </div>
        <div class="step reveal" style="--d:0.16s">
          <span class="num">03</span>
          <h3><span class="l-en">Or use the browser</span><span class="l-zh">或者用浏览器</span></h3>
          <p><span class="l-en">Keep it on your machine, or turn on a token or password before sharing it over a tunnel or remote port.</span><span class="l-zh">只在本机用就保持默认；要通过隧道或远程端口分享时，先开启令牌或密码。</span></p>
          <code>reasonix serve --auth token</code>
        </div>
        <div class="step reveal" style="--d:0.24s">
          <span class="num">04</span>
          <h3><span class="l-en">Review and continue</span><span class="l-zh">查看结果，接着做</span></h3>
          <p><span class="l-en">Queue follow-up tasks, review the changes, and pick a session up again later.</span><span class="l-zh">排上后续任务，查看改动，之后随时接着上次的会话继续。</span></p>
          <code>› refactor the auth flow</code>
        </div>
      </div>
    </div>
  </section>

  <div class="divider" aria-hidden="true"><span class="line"></span></div>

  <section id="community">
    <div class="wrap">
      <div class="sec-head split reveal">
        <span class="kicker"><span class="l-en">Community</span><span class="l-zh">社区共建</span></span>
        <h2><span class="l-en">Built in the open, with <span class="em">{community.contributors} contributors.</span></span><span class="l-zh">开源共建,感谢 <span class="em">{community.contributors} 位贡献者。</span></span></h2>
        <p><span class="l-en">Reasonix is MIT-licensed and developed in public. Every issue, every PR, every late-night review made it what it is — thank you.</span><span class="l-zh">Reasonix 采用 MIT 许可,开放开发。每一个 issue、每一条 PR、每一次深夜 review,成就了今天的它——谢谢你们。</span></p>
      </div>
    </div>
    <div class="crew reveal" aria-hidden="false">
      <div class="crew-row">
        <span class="crew-set">
          {rowA.map((c, i) => (
            <a class={avClass(i)} data-h={`@${c.login}`} href={c.url} target="_blank" rel="noreferrer" aria-label={c.login}>
              <img src={c.avatar} alt={c.login} loading="lazy" width="60" height="60" />
            </a>
          ))}
        </span>
      </div>
      <div class="crew-row rev">
        <span class="crew-set">
          {rowB.map((c, i) => (
            <a class={avClass(i + 3)} data-h={`@${c.login}`} href={c.url} target="_blank" rel="noreferrer" aria-label={c.login}>
              <img src={c.avatar} alt={c.login} loading="lazy" width="60" height="60" />
            </a>
          ))}
          <a class="av you" data-h="this could be you · 虚位以待" href={`${repo}/issues`} target="_blank" rel="noreferrer">+</a>
        </span>
      </div>
    </div>
    <div class="wrap">
      <div class="crew-cta reveal">
        <a class="btn btn-dark" href={repo}><span class="l-en">Contribute on GitHub</span><span class="l-zh">在 GitHub 上参与贡献</span></a>
        <a class="btn btn-ghost" href={`${repo}/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22`}><span class="l-en">Good first issues →</span><span class="l-zh">新手友好任务 →</span></a>
      </div>
      <div class="crew-note reveal"><span class="l-en">{fmtN(community.stars)} stars · {fmtN(community.mergedPrs)} merged PRs · every avatar above is a real contributor</span><span class="l-zh">{fmtN(community.stars)} stars · {fmtN(community.mergedPrs)} 个已合并 PR · 上面每个头像都是一位真实贡献者</span></div>
    </div>
  </section>

  <section class="cta" id="start">
    <h2 class="reveal"><span class="l-en">Try it on a <span class="em">real project.</span></span><span class="l-zh">拿一个<span class="em">真实项目</span>试试。</span></h2>
