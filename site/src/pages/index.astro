  <script>

    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('.install-option').forEach((col) => {
        const canvas = col.querySelector('.particle-canvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        let particles = [];
        let rafId = null;

        canvas.style.willChange = 'transform';

        function resize() {
          const r = col.getBoundingClientRect();
          canvas.width = Math.max(1, Math.round(r.width * devicePixelRatio));
          canvas.height = Math.max(1, Math.round(r.height * devicePixelRatio));
          ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
        }
        resize();

        function loop() {
          const r = col.getBoundingClientRect();
          const isDark = document.documentElement.dataset.theme === 'dark';
          const base = isDark ? '255,255,255' : '0,0,0';
          ctx.clearRect(0, 0, r.width, r.height);
          particles = particles.filter((p) => p.life > 0);
          particles.forEach((p) => {
            p.x += p.vx;
            p.y += p.vy;
            p.vy += 0.01;
            p.life -= p.decay;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(${base},${(p.life * 0.28).toFixed(3)})`;
            ctx.fill();
          });
          rafId = particles.length ? requestAnimationFrame(loop) : null;
        }

        col.addEventListener('mousemove', (e) => {
          const r = col.getBoundingClientRect();
          const mx = e.clientX - r.left;
          const my = e.clientY - r.top;

          if (particles.length > 80) return;

          for (let i = 0; i < 2; i++) {
            particles.push({
              x: mx + (Math.random() - 0.5) * 20,
              y: my + (Math.random() - 0.5) * 20,
              vx: (Math.random() - 0.5) * 1.2,
              vy: (Math.random() - 0.5) * 1.2 - 0.3,
              life: 1,
              decay: 0.015 + Math.random() * 0.015,
              size: 1.2 + Math.random() * 1.8,
            });
          }
          if (!rafId) loop();
        });

        window.addEventListener('resize', resize);
      });
    }
  </script>
