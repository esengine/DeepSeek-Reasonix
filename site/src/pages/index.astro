---
import "../styles/ip-platform.css";

const documents = [
  { id: "DOC-0318", name: "星穹推理引擎技术白皮书 V3.2.pdf", category: "技术白皮书", owner: "算法研发中心", size: "18.6 MB", status: "分析中", updated: "刚刚" },
  { id: "DOC-0317", name: "生成式检索核心专利组合.pdf", category: "专利文档", owner: "知识产权部", size: "8.2 MB", status: "已完成", updated: "12 分钟前" },
  { id: "DOC-0316", name: "智算中心联合研发协议.docx", category: "技术合同", owner: "法务合规部", size: "2.4 MB", status: "待复核", updated: "46 分钟前" },
  { id: "DOC-0315", name: "多模态语义索引产品规范.pptx", category: "产品规范", owner: "产品平台部", size: "12.1 MB", status: "已完成", updated: "昨天" },
  { id: "DOC-0314", name: "联邦推理安全评估报告.xlsx", category: "评估报告", owner: "安全委员会", size: "4.7 MB", status: "已脱敏", updated: "昨天" },
];

const assets = [
  { id: "IP-2026-0841", name: "稀疏专家路由与动态负载均衡方法", type: "技术方案", owner: "推理架构组", sensitivity: "机密", confidence: "98.6%", citations: 14 },
  { id: "IP-2026-0840", name: "长上下文分层缓存策略", type: "算法模型", owner: "基础模型组", sensitivity: "内部", confidence: "96.4%", citations: 9 },
  { id: "IP-2026-0839", name: "跨模态语义一致性评估体系", type: "评估方法", owner: "多模态组", sensitivity: "内部", confidence: "94.8%", citations: 11 },
  { id: "IP-2026-0838", name: "异构算力运行时编排框架", type: "软件架构", owner: "平台工程部", sensitivity: "机密", confidence: "93.2%", citations: 18 },
  { id: "IP-2026-0837", name: "推理服务 SLA 分级模型", type: "业务规则", owner: "解决方案部", sensitivity: "公开", confidence: "91.7%", citations: 6 },
];
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="intelifar 企业级长文档 IP 智能分析与 Wiki 管理平台" />
    <meta name="theme-color" content="#171823" />
    <link rel="icon" type="image/png" href="/brand/intelifar-favicon.png" />
    <title>灵遐智析 · intelifar IP Intelligence</title>
  </head>
  <body data-session-state="checking">
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <div class="app-shell">
      <aside class="sidebar" aria-label="主导航">
        <div class="brand-lockup">
          <img class="brand-logo brand-logo-light" src="/brand/intelifar-logo-dark.png" alt="intelifar 灵遐智能" />
          <img class="brand-logo brand-logo-dark" src="/brand/intelifar-logo.png" alt="intelifar 灵遐智能" />
          <span class="product-mark">IP INTELLIGENCE</span>
        </div>

        <div class="tenant-chip" data-testid="workspace-identity">
          <span class="tenant-avatar" id="workspace-avatar">澜</span>
          <span><strong id="workspace-name">澜图科技</strong><small id="workspace-mode">正在验证工作空间</small></span>
          <span aria-hidden="true">⌄</span>
        </div>

        <nav class="primary-nav">
          <p class="nav-label">工作空间</p>
          <button class="nav-item is-active" data-nav="overview" data-testid="nav-overview" aria-controls="view-overview" aria-current="page"><span class="nav-icon">⌂</span><span>指挥台</span></button>
          <button class="nav-item" data-nav="tasks" data-testid="nav-tasks" aria-controls="view-tasks"><span class="nav-icon">✓</span><span>待办中心</span><span class="nav-badge warn" id="nav-task-count">—</span></button>
          <button class="nav-item" data-nav="documents" data-testid="nav-documents" aria-controls="view-documents"><span class="nav-icon">▤</span><span>文档中心</span><span class="nav-badge" id="nav-document-count">—</span></button>
          <button class="nav-item" data-nav="analysis" data-testid="nav-analysis" aria-controls="view-analysis"><span class="nav-icon">◇</span><span>智能分析</span><span class="live-dot" title="运行中"></span></button>
          <button class="nav-item" data-nav="agent" data-testid="nav-agent" aria-controls="view-agent"><span class="nav-icon">✦</span><span>IP 任务助手</span><span class="agent-nav-mark">受控</span></button>
          <button class="nav-item" data-nav="assets" data-testid="nav-assets" aria-controls="view-assets"><span class="nav-icon">⬡</span><span>IP 资产库</span></button>
          <button class="nav-item" data-nav="wiki" data-testid="nav-wiki" aria-controls="view-wiki"><span class="nav-icon">⌘</span><span>IP Wiki</span></button>

          <p class="nav-label">治理与安全</p>
          <button class="nav-item" data-nav="redaction" data-testid="nav-redaction" aria-controls="view-redaction"><span class="nav-icon">▰</span><span>风险线索</span><span class="nav-badge warn" id="nav-redaction-count">—</span></button>
          <button class="nav-item" data-nav="lifecycle" data-testid="nav-lifecycle" aria-controls="view-lifecycle"><span class="nav-icon">◎</span><span>生命周期</span></button>
          <button class="nav-item" data-nav="audit" data-testid="nav-audit" aria-controls="view-audit"><span class="nav-icon">≣</span><span>操作记录</span></button>
          <button class="nav-item" data-nav="members" data-testid="nav-members" aria-controls="view-members"><span class="nav-icon">♙</span><span>成员与权限</span></button>
          <button class="nav-item" data-nav="system" data-testid="nav-system" aria-controls="view-system"><span class="nav-icon">⚙</span><span>系统状态</span></button>
        </nav>

        <div class="sidebar-foot">
          <div class="security-note"><span>◆</span><span><strong>受控文档处理</strong><small>仅处理已授权上传的资料</small></span></div>
          <div class="profile-chip"><button class="profile-permissions" id="open-my-permissions" data-testid="open-my-permissions" type="button" aria-label="查看我的权限"><span class="profile-avatar" id="profile-avatar">林</span><span><strong id="profile-name">林越</strong><small id="profile-role">正在验证身份</small></span></button><button id="logout-button" aria-label="退出当前账号" title="退出登录">↪</button></div>
        </div>
      </aside>

      <div class="workspace">
        <header class="topbar">
          <button class="mobile-menu" id="mobile-menu" aria-label="打开导航" aria-expanded="false">☰</button>
          <div class="breadcrumb"><span>澜图科技</span><b>/</b><strong id="page-title">企业 IP 指挥台</strong></div>
          <div class="global-search-shell">
            <label class="global-search">
              <span aria-hidden="true">⌕</span>
              <span class="sr-only">全局搜索</span>
              <input id="global-search" type="search" placeholder="搜索全部 Wiki、资产或原文依据" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="global-search-results" autocomplete="off" />
              <kbd>⌘ K</kbd>
            </label>
            <section class="global-search-results" id="global-search-results" role="listbox" aria-label="全局搜索结果" hidden><div class="global-search-state">输入至少 2 个字，查找当前账号可见知识</div></section>
          </div>
          <div class="topbar-actions">
            <button class="icon-btn mobile-search-trigger" id="mobile-global-search" aria-label="搜索全部 Wiki">⌕</button>
            <button class="icon-btn" id="theme-toggle" aria-label="切换明暗主题">◐</button>
            <button class="icon-btn notification" aria-label="通知">♢<span></span></button>
            <button class="primary-btn compact" data-open-intake data-testid="top-new-analysis"><span>＋</span> 新建分析</button>
          </div>
        </header>

        <main id="main-content" tabindex="-1">
          <p class="role-action-note" id="readonly-role-note" hidden><span>只读岗位</span> 您可以查找 Wiki、核验原文依据并运行只读任务；文档接入、正式更新和全空间审计由知识编辑者或管理员负责。</p>
          <section class="view is-active" id="view-overview" data-view="overview">
            <div class="page-intro overview-intro">
              <div>
                <p class="eyebrow" id="overview-date">企业知识态势</p>
                <h1 id="overview-greeting">早上好，林越</h1>
                <p id="overview-summary">正在读取当前工作空间数据…</p>
              </div>
              <div class="intro-actions">
                <button class="secondary-btn" data-nav-target="audit">查看审计</button>
                <button class="primary-btn" data-open-intake data-testid="overview-new-analysis">＋ 接入新文档</button>
              </div>
            </div>

            <div class="metrics-grid" aria-label="关键指标">
              <article class="metric-card accent-card">
                <div class="metric-head"><span>结构化 IP 资产</span><i id="metric-assets-period">当前已发布记录</i></div>
                <strong id="metric-assets-total">—</strong><p id="metric-assets-detail">正在读取真实资产</p>
                <div class="sparkline" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
              </article>
              <article class="metric-card"><div class="metric-head"><span>原文依据覆盖</span><i>目标 ≥ 95%</i></div><strong id="metric-evidence-coverage">—</strong><p id="metric-evidence-detail"><span class="good-dot"></span> 正在核验原文依据</p><div class="meter"><span id="metric-evidence-meter" style="width:0%"></span></div></article>
              <article class="metric-card"><div class="metric-head"><span>文档记录</span><i id="metric-documents-total">正在处理 —</i></div><strong id="metric-documents-processing">—</strong><p id="metric-documents-detail">正在读取任务队列</p><div class="mini-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div></article>
              <article class="metric-card risk-card"><div class="metric-head"><span>敏感命中</span><i id="metric-risk-high">待复核 — 项</i></div><strong id="metric-risk-total">—</strong><p>来自当前工作空间分析结果</p><button class="text-link" data-nav-target="redaction">进入安全工作台 →</button></article>
            </div>

            <article class="panel pipeline-panel" data-demo-dashboard>
              <div class="panel-head"><div><span class="kicker">处理进度</span><h2>长文档智能处理链路</h2></div><button class="text-link" data-nav-target="analysis">查看运行详情 →</button></div>
              <div class="pipeline-summary"><div><span class="file-glyph">PDF</span><span><strong>星穹推理引擎技术白皮书 V3.2.pdf</strong><small>18.6 MB · 326 页 · 技术白皮书</small></span></div><div class="job-status"><span class="pulse"></span><span><b id="overview-progress-text">正在交叉校验</b><small>任务 JOB-240809-018</small></span><strong id="overview-progress-number">72%</strong></div></div>
              <div class="pipeline-track" id="overview-pipeline">
                <div class="pipeline-line"><span id="overview-pipeline-fill" style="width:72%"></span></div>
                <div class="pipeline-step is-complete" data-threshold="18"><span>✓</span><b>文档解析</b><small>326 页</small></div>
                <div class="pipeline-step is-complete" data-threshold="36"><span>✓</span><b>智能分类</b><small>技术白皮书</small></div>
                <div class="pipeline-step is-complete" data-threshold="62"><span>✓</span><b>IP 提取</b><small>发现 18 项</small></div>
                <div class="pipeline-step is-active" data-threshold="82"><span>4</span><b>交叉校验</b><small>多模型校验中</small></div>
                <div class="pipeline-step" data-threshold="100"><span>5</span><b>Wiki 生成</b><small>等待中</small></div>
              </div>
            </article>

            <div class="dashboard-grid" data-demo-dashboard>
              <article class="panel">
                <div class="panel-head"><div><span class="kicker">RISK QUEUE</span><h2>待复核风险</h2></div><span class="count-pill">3 项高优先级</span></div>
                <div class="risk-list">
                  <button class="risk-item" data-nav-target="redaction"><span class="risk-level high">高</span><span><strong>核心算法参数未完全涂黑</strong><small>星穹推理引擎白皮书 · 第 114 页</small></span><time>8 分钟前</time></button>
                  <button class="risk-item" data-nav-target="lifecycle"><span class="risk-level medium">中</span><span><strong>外部分享即将到期</strong><small>智算中心联合研发协议 · 2 位访客</small></span><time>1 小时后</time></button>
                  <button class="risk-item" data-nav-target="assets"><span class="risk-level low">低</span><span><strong>资产权属信息待确认</strong><small>异构算力运行时编排框架</small></span><time>昨天</time></button>
                </div>
              </article>
              <article class="panel">
                <div class="panel-head"><div><span class="kicker">KNOWLEDGE SIGNAL</span><h2>资产主题分布</h2></div><button class="icon-btn small" aria-label="更多">•••</button></div>
                <div class="topic-cloud" aria-label="资产主题分布"><span class="topic-main">推理优化<small>286</small></span><span>知识检索<small>214</small></span><span>多模态<small>186</small></span><span>安全合规<small>147</small></span><span>算力调度<small>132</small></span><span>数据治理<small>109</small></span></div>
              </article>
            </div>

            <article class="panel table-panel">
              <div class="panel-head"><div><span class="kicker">RECENT ASSETS</span><h2>最新沉淀的 IP 资产</h2></div><button class="secondary-btn small" data-nav-target="assets">查看全部资产</button></div>
              <div class="data-table-wrap"><table class="data-table"><thead><tr><th>资产名称</th><th>类型</th><th>权属部门</th><th>敏感级别</th><th>置信度</th><th>溯源</th></tr></thead><tbody id="overview-asset-table-body">{assets.slice(0, 4).map((asset) => <tr class="clickable-row" data-demo-asset data-asset-id={asset.id}><td><span class="asset-title"><i>IP</i><span><strong>{asset.name}</strong><small>{asset.id}</small></span></span></td><td>{asset.type}</td><td>{asset.owner}</td><td><span class:list={["status-chip", asset.sensitivity === "机密" && "danger", asset.sensitivity === "内部" && "info"]}>{asset.sensitivity}</span></td><td><span class="confidence">{asset.confidence}</span></td><td><button class="source-count" data-open-provenance data-evidence-id="DEMO-S-049-01">{asset.citations} 处 ↗</button></td></tr>)}</tbody></table></div>
            </article>
          </section>

          <section class="view" id="view-tasks" data-view="tasks" data-testid="view-tasks" hidden>
            <div class="page-intro"><div><p class="eyebrow">MY ACTIONS</p><h1>待办中心</h1><p>只汇总当前岗位能够处理的事项，并说明为什么需要处理以及完成后会影响什么。</p></div><button class="secondary-btn" id="refresh-workspace-actions" type="button">↻ 刷新待办</button></div>
            <div class="action-summary-grid" aria-label="待办概览"><article><span>全部待办</span><strong id="action-total-count">—</strong><small>来自当前工作空间真实状态</small></article><article><span>优先处理</span><strong id="action-urgent-count">—</strong><small>发布审批或异常任务</small></article><article><span>内容与发布</span><strong id="action-content-count">—</strong><small>Wiki 与文档处理</small></article><article><span>资产治理</span><strong id="action-governance-count">—</strong><small>权属、密级与关系</small></article></div>
            <article class="panel action-center-panel"><div class="action-filter-bar" role="group" aria-label="筛选待办"><button class="is-active" data-action-filter="all" aria-pressed="true">全部</button><button data-action-filter="content" aria-pressed="false">内容与发布</button><button data-action-filter="governance" aria-pressed="false">资产治理</button><button data-action-filter="access" aria-pressed="false">成员协作</button><button data-action-filter="operations" aria-pressed="false">系统维护</button><span id="action-filter-status" role="status">正在读取待办</span></div><div class="workspace-action-list" id="workspace-action-list"><div class="ledger-empty">正在根据当前岗位整理待办…</div></div></article>
          </section>

          <section class="view" id="view-documents" data-view="documents" hidden>
            <div class="page-intro"><div><p class="eyebrow">DOCUMENT INTAKE</p><h1>文档中心</h1><p>统一接入、解析与治理企业长文档，支持 30+ 分类和主流办公格式。</p></div><button class="primary-btn" data-open-intake data-testid="documents-upload">＋ 接入文档</button></div>
            <p class="role-action-note" id="document-role-note" hidden><span>当前为只读岗位</span> 您可以查看已发布文档和知识结果；如需接入新资料，请联系知识编辑者或空间管理员。</p>
            <div class="capability-strip"><span><i>30+</i><b>业务文档类型</b><small>专利、合同、白皮书等提取规则</small></span><span><i>9+</i><b>支持文件格式</b><small>PDF / DOC / PPT / 图片 / HTML</small></span><span><i>25 MB</i><b>单文件上限</b><small>文件类型、大小与内容联合检查</small></span><span><i>2</i><b>智能处理步骤</b><small>读取文档 · 提取知识资产</small></span></div>
            <article class="panel table-panel">
              <div class="table-toolbar"><label class="table-search"><span>⌕</span><input id="document-search" type="search" placeholder="搜索文档名称或责任部门" /></label><select id="document-filter" aria-label="按状态筛选"><option value="all">全部状态</option><option>已完成</option><option>分析中</option><option>待复核</option><option>已脱敏</option></select><button class="secondary-btn" id="document-advanced-filter" aria-expanded="false" aria-controls="document-advanced-filters">高级筛选</button><span class="toolbar-spacer"></span><span class="muted-copy" id="document-filter-status" role="status">正在读取文档</span><button class="icon-btn small" aria-label="列表视图">☷</button><button class="icon-btn small" aria-label="刷新文档列表">↻</button></div>
              <div class="advanced-filter-panel" id="document-advanced-filters" hidden>
                <label><span>文档分类</span><select id="document-category-filter"><option value="all">全部分类</option></select></label>
                <label><span>责任部门</span><select id="document-owner-filter"><option value="all">全部部门</option></select></label>
                <label class="filter-check"><input id="document-action-filter" type="checkbox" /> 仅显示需要处理的文档</label>
                <button class="text-link" id="document-filter-reset" type="button">清除筛选</button>
              </div>
              <div class="data-table-wrap"><table class="data-table document-table"><thead><tr><th><input type="checkbox" aria-label="全选" /></th><th>文档</th><th>智能分类</th><th>责任部门</th><th>处理状态</th><th>更新时间</th><th></th></tr></thead><tbody id="document-table-body">{documents.map((doc) => <tr data-document-row data-demo-document data-name={doc.name} data-owner={doc.owner} data-category={doc.category} data-status={doc.status}><td><input type="checkbox" aria-label={`选择 ${doc.name}`} /></td><td><span class="asset-title"><i class="file-type">{doc.name.split(".").at(-1)?.toUpperCase()}</i><span><strong>{doc.name}</strong><small>{doc.id} · {doc.size}</small></span></span></td><td><span class="category-chip">{doc.category}</span></td><td>{doc.owner}</td><td><span class:list={["status-chip", doc.status === "分析中" && "processing", doc.status === "待复核" && "warning", doc.status === "已脱敏" && "secure"]}>{doc.status === "分析中" && <i class="spinner"></i>}{doc.status}</span></td><td>{doc.updated}</td><td><button class="icon-btn small" aria-label="文档操作">•••</button></td></tr>)}</tbody></table></div>
              <div class="table-footer"><span id="document-total">演示样本 5 份</span><div id="document-pagination"><button disabled>‹</button><button class="is-current">1</button><button disabled>›</button></div></div>
            </article>
          </section>

          <section class="view" id="view-analysis" data-view="analysis" hidden>
            <div class="page-intro"><div><p class="eyebrow">文档智能</p><h1>智能分析</h1><p>按业务规则完成分类、知识提取和原文核验。</p></div><div class="intro-actions"><span class="health-chip" id="provider-health-chip"><i></i> 正在检查分析服务</span><button class="primary-btn" data-open-intake>＋ 新分析</button></div></div>
            <article class="analysis-hero panel">
              <div class="analysis-meta"><span class="file-glyph large" id="analysis-file-type">PDF</span><div><span class="status-chip processing"><i class="spinner"></i><span id="analysis-status-label">运行中</span></span><h2>星穹推理引擎技术白皮书 V3.2.pdf</h2><p id="analysis-meta-copy">JOB-240809-018 · 技术白皮书 · 326 页 · 创建于 09:24</p></div><div class="analysis-score"><span id="analysis-progress-ring" style="--progress:72"><strong id="analysis-progress-number">72%</strong></span><small>总体进度</small></div></div>
              <div class="analysis-stage-grid" id="analysis-stage-grid">
                <article class="analysis-stage is-complete" data-threshold="18"><span>01</span><div><b>读取文档内容</b><small id="analysis-stage-parse-detail">等待真实任务</small></div><strong>✓</strong></article>
                <article class="analysis-stage is-complete" data-threshold="36"><span>02</span><div><b>识别文档类型</b><small id="analysis-stage-classify-detail">等待真实任务</small></div><strong>✓</strong></article>
                <article class="analysis-stage is-complete" data-threshold="62"><span>03</span><div><b>提取知识资产</b><small id="analysis-stage-assets-detail">等待真实任务</small></div><strong>✓</strong></article>
