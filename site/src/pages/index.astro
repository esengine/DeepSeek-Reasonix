---
import "../styles/ip-platform.css";

const documents = [
  { id: "DOC-0318", name: "星穹推理引擎技术白皮书 V3.2.pdf", category: "技术白皮书", owner: "算法研发中心", size: "18.6 MB", status: "分析中", updated: "刚刚" },
  { id: "DOC-0317", name: "生成式检索核心专利组合.pdf", category: "专利文档", owner: "知识产权部", size: "8.2 MB", status: "已完成", updated: "12 分钟前" },
  { id: "DOC-0316", name: "智算中心联合研发协议.docx", category: "技术合同", owner: "法务合规部", size: "2.4 MB", status: "待复核", updated: "46 分钟前" },
  { id: "DOC-0315", name: "多模态语义索引产品规范.pptx", category: "产品规范", owner: "产品平台部", size: "12.1 MB", status: "已完成", updated: "昨天" },
  { id: "DOC-0314", name: "联邦推理安全评估报告.xlsx", category: "评估报告", owner: "安全委员会", size: "4.7 MB", status: "已脱敏", updated: "昨天" },
];

const assets = [
  { id: "IP-2026-0841", name: "稀疏专家路由与动态负载均衡方法", type: "技术方案", owner: "推理架构组", sensitivity: "机密", confidence: "98.6%", citations: 14 },
  { id: "IP-2026-0840", name: "长上下文分层缓存策略", type: "算法模型", owner: "基础模型组", sensitivity: "内部", confidence: "96.4%", citations: 9 },
  { id: "IP-2026-0839", name: "跨模态语义一致性评估体系", type: "评估方法", owner: "多模态组", sensitivity: "内部", confidence: "94.8%", citations: 11 },
  { id: "IP-2026-0838", name: "异构算力运行时编排框架", type: "软件架构", owner: "平台工程部", sensitivity: "机密", confidence: "93.2%", citations: 18 },
  { id: "IP-2026-0837", name: "推理服务 SLA 分级模型", type: "业务规则", owner: "解决方案部", sensitivity: "公开", confidence: "91.7%", citations: 6 },
];
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="intelifar 企业级长文档 IP 智能分析与 Wiki 管理平台" />
    <meta name="theme-color" content="#171823" />
    <link rel="icon" type="image/png" href="/brand/intelifar-favicon.png" />
    <title>灵遐智析 · intelifar IP Intelligence</title>
  </head>
  <body data-session-state="checking">
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <div class="app-shell">
      <aside class="sidebar" aria-label="主导航">
        <div class="brand-lockup">
          <img class="brand-logo brand-logo-light" src="/brand/intelifar-logo-dark.png" alt="intelifar 灵遐智能" />
          <img class="brand-logo brand-logo-dark" src="/brand/intelifar-logo.png" alt="intelifar 灵遐智能" />
          <span class="product-mark">IP INTELLIGENCE</span>
        </div>

        <div class="tenant-chip" data-testid="workspace-identity">
          <span class="tenant-avatar" id="workspace-avatar">澜</span>
          <span><strong id="workspace-name">澜图科技</strong><small id="workspace-mode">正在验证工作空间</small></span>
          <span aria-hidden="true">⌄</span>
        </div>

        <nav class="primary-nav">
          <p class="nav-label">工作空间</p>
          <button class="nav-item is-active" data-nav="overview" data-testid="nav-overview" aria-controls="view-overview" aria-current="page"><span class="nav-icon">⌂</span><span>指挥台</span></button>
          <button class="nav-item" data-nav="documents" data-testid="nav-documents" aria-controls="view-documents"><span class="nav-icon">▤</span><span>文档中心</span><span class="nav-badge">17</span></button>
          <button class="nav-item" data-nav="analysis" data-testid="nav-analysis" aria-controls="view-analysis"><span class="nav-icon">◇</span><span>智能分析</span><span class="live-dot" title="运行中"></span></button>
          <button class="nav-item" data-nav="assets" data-testid="nav-assets" aria-controls="view-assets"><span class="nav-icon">⬡</span><span>IP 资产库</span></button>
          <button class="nav-item" data-nav="wiki" data-testid="nav-wiki" aria-controls="view-wiki"><span class="nav-icon">⌘</span><span>IP Wiki</span></button>

          <p class="nav-label">治理与安全</p>
          <button class="nav-item" data-nav="redaction" data-testid="nav-redaction" aria-controls="view-redaction"><span class="nav-icon">▰</span><span>脱敏与溯源</span><span class="nav-badge warn">23</span></button>
          <button class="nav-item" data-nav="lifecycle" data-testid="nav-lifecycle" aria-controls="view-lifecycle"><span class="nav-icon">◎</span><span>生命周期</span></button>
          <button class="nav-item" data-nav="audit" data-testid="nav-audit" aria-controls="view-audit"><span class="nav-icon">≣</span><span>审计日志</span></button>
          <button class="nav-item" data-nav="system" data-testid="nav-system" aria-controls="view-system"><span class="nav-icon">⚙</span><span>系统状态</span></button>
        </nav>

        <div class="sidebar-foot">
          <div class="security-note"><span>◆</span><span><strong>受控文档处理</strong><small>仅处理已授权上传的资料</small></span></div>
          <div class="profile-chip"><span class="profile-avatar" id="profile-avatar">林</span><span><strong id="profile-name">林越</strong><small id="profile-role">正在验证身份</small></span><button id="logout-button" aria-label="退出当前账号" title="退出登录">↪</button></div>
        </div>
      </aside>

      <div class="workspace">
        <header class="topbar">
          <button class="mobile-menu" id="mobile-menu" aria-label="打开导航" aria-expanded="false">☰</button>
          <div class="breadcrumb"><span>澜图科技</span><b>/</b><strong id="page-title">企业 IP 指挥台</strong></div>
          <label class="global-search">
            <span aria-hidden="true">⌕</span>
            <span class="sr-only">全局搜索</span>
            <input id="global-search" type="search" placeholder="搜索文档、IP 资产或溯源编号" />
            <kbd>⌘ K</kbd>
          </label>
          <div class="topbar-actions">
            <button class="icon-btn" id="theme-toggle" aria-label="切换明暗主题">◐</button>
            <button class="icon-btn notification" aria-label="通知">♢<span></span></button>
            <button class="primary-btn compact" data-open-intake data-testid="top-new-analysis"><span>＋</span> 新建分析</button>
          </div>
        </header>

        <main id="main-content" tabindex="-1">
          <section class="view is-active" id="view-overview" data-view="overview">
            <div class="page-intro overview-intro">
              <div>
                <p class="eyebrow">2026 年 8 月 9 日 · 企业知识态势</p>
                <h1>早上好，林越</h1>
                <p>过去 24 小时新增 <strong>42 项</strong>可复用 IP 资产，3 项高敏内容需要你复核。</p>
              </div>
              <div class="intro-actions">
                <button class="secondary-btn" data-nav-target="audit">查看审计</button>
                <button class="primary-btn" data-open-intake data-testid="overview-new-analysis">＋ 接入新文档</button>
              </div>
            </div>

            <div class="metrics-grid" aria-label="关键指标">
              <article class="metric-card accent-card">
                <div class="metric-head"><span>结构化 IP 资产</span><i>↗ 12.4%</i></div>
                <strong>1,284</strong><p>本月新增 146 项</p>
                <div class="sparkline" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
              </article>
              <article class="metric-card"><div class="metric-head"><span>溯源覆盖率</span><i>目标 ≥ 95%</i></div><strong>96.8<small>%</small></strong><p><span class="good-dot"></span> 1,243 项已绑定原文</p><div class="meter"><span style="width:96.8%"></span></div></article>
              <article class="metric-card"><div class="metric-head"><span>待处理文档</span><i>5 个队列</i></div><strong>17</strong><p>预计 26 分钟内完成</p><div class="mini-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div></article>
              <article class="metric-card risk-card"><div class="metric-head"><span>敏感命中</span><i>需复核 3 项</i></div><strong>23</strong><p>较昨日减少 8 项</p><button class="text-link" data-nav-target="redaction">进入安全工作台 →</button></article>
            </div>

            <article class="panel pipeline-panel">
              <div class="panel-head"><div><span class="kicker">LIVE PIPELINE</span><h2>长文档智能处理链路</h2></div><button class="text-link" data-nav-target="analysis">查看运行详情 →</button></div>
              <div class="pipeline-summary"><div><span class="file-glyph">PDF</span><span><strong>星穹推理引擎技术白皮书 V3.2.pdf</strong><small>18.6 MB · 326 页 · 技术白皮书</small></span></div><div class="job-status"><span class="pulse"></span><span><b id="overview-progress-text">正在交叉校验</b><small>任务 JOB-240809-018</small></span><strong id="overview-progress-number">72%</strong></div></div>
              <div class="pipeline-track" id="overview-pipeline">
                <div class="pipeline-line"><span id="overview-pipeline-fill" style="width:72%"></span></div>
                <div class="pipeline-step is-complete" data-threshold="18"><span>✓</span><b>文档解析</b><small>326 页</small></div>
                <div class="pipeline-step is-complete" data-threshold="36"><span>✓</span><b>智能分类</b><small>技术白皮书</small></div>
                <div class="pipeline-step is-complete" data-threshold="62"><span>✓</span><b>IP 提取</b><small>发现 18 项</small></div>
                <div class="pipeline-step is-active" data-threshold="82"><span>4</span><b>交叉校验</b><small>多模型校验中</small></div>
                <div class="pipeline-step" data-threshold="100"><span>5</span><b>Wiki 生成</b><small>等待中</small></div>
              </div>
            </article>

            <div class="dashboard-grid">
              <article class="panel">
                <div class="panel-head"><div><span class="kicker">RISK QUEUE</span><h2>待复核风险</h2></div><span class="count-pill">3 项高优先级</span></div>
                <div class="risk-list">
                  <button class="risk-item" data-nav-target="redaction"><span class="risk-level high">高</span><span><strong>核心算法参数未完全涂黑</strong><small>星穹推理引擎白皮书 · 第 114 页</small></span><time>8 分钟前</time></button>
                  <button class="risk-item" data-nav-target="lifecycle"><span class="risk-level medium">中</span><span><strong>外部分享即将到期</strong><small>智算中心联合研发协议 · 2 位访客</small></span><time>1 小时后</time></button>
                  <button class="risk-item" data-nav-target="assets"><span class="risk-level low">低</span><span><strong>资产权属信息待确认</strong><small>异构算力运行时编排框架</small></span><time>昨天</time></button>
                </div>
              </article>
              <article class="panel">
                <div class="panel-head"><div><span class="kicker">KNOWLEDGE SIGNAL</span><h2>资产主题分布</h2></div><button class="icon-btn small" aria-label="更多">•••</button></div>
                <div class="topic-cloud" aria-label="资产主题分布"><span class="topic-main">推理优化<small>286</small></span><span>知识检索<small>214</small></span><span>多模态<small>186</small></span><span>安全合规<small>147</small></span><span>算力调度<small>132</small></span><span>数据治理<small>109</small></span></div>
              </article>
            </div>

            <article class="panel table-panel">
              <div class="panel-head"><div><span class="kicker">RECENT ASSETS</span><h2>最新沉淀的 IP 资产</h2></div><button class="secondary-btn small" data-nav-target="assets">查看全部资产</button></div>
              <div class="data-table-wrap"><table class="data-table"><thead><tr><th>资产名称</th><th>类型</th><th>权属部门</th><th>敏感级别</th><th>置信度</th><th>溯源</th></tr></thead><tbody>{assets.slice(0, 4).map((asset) => <tr class="clickable-row" data-asset-id={asset.id}><td><span class="asset-title"><i>IP</i><span><strong>{asset.name}</strong><small>{asset.id}</small></span></span></td><td>{asset.type}</td><td>{asset.owner}</td><td><span class:list={["status-chip", asset.sensitivity === "机密" && "danger", asset.sensitivity === "内部" && "info"]}>{asset.sensitivity}</span></td><td><span class="confidence">{asset.confidence}</span></td><td><button class="source-count" data-open-provenance>{asset.citations} 处 ↗</button></td></tr>)}</tbody></table></div>
            </article>
          </section>

          <section class="view" id="view-documents" data-view="documents" hidden>
            <div class="page-intro"><div><p class="eyebrow">DOCUMENT INTAKE</p><h1>文档中心</h1><p>统一接入、解析与治理企业长文档，支持 30+ 分类和主流办公格式。</p></div><button class="primary-btn" data-open-intake data-testid="documents-upload">＋ 接入文档</button></div>
            <div class="capability-strip"><span><i>30+</i><b>可配置分类</b><small>专利、合同、白皮书等业务 Schema</small></span><span><i>9+</i><b>真实网关格式</b><small>PDF / DOC / PPT / 图片 / HTML</small></span><span><i>25 MB</i><b>单文件上限</b><small>扩展名、大小与文件签名联合校验</small></span><span><i>2</i><b>外部处理器</b><small>MinerU 解析 · DeepSeek 结构化</small></span></div>
            <article class="panel table-panel">
              <div class="table-toolbar"><label class="table-search"><span>⌕</span><input id="document-search" type="search" placeholder="搜索文档名称或责任部门" /></label><select id="document-filter" aria-label="按状态筛选"><option value="all">全部状态</option><option>已完成</option><option>分析中</option><option>待复核</option><option>已脱敏</option></select><button class="secondary-btn">高级筛选</button><span class="toolbar-spacer"></span><button class="icon-btn small" aria-label="列表视图">☷</button><button class="icon-btn small" aria-label="刷新">↻</button></div>
              <div class="data-table-wrap"><table class="data-table document-table"><thead><tr><th><input type="checkbox" aria-label="全选" /></th><th>文档</th><th>智能分类</th><th>责任部门</th><th>处理状态</th><th>更新时间</th><th></th></tr></thead><tbody id="document-table-body">{documents.map((doc) => <tr data-document-row data-name={doc.name} data-owner={doc.owner} data-status={doc.status}><td><input type="checkbox" aria-label={`选择 ${doc.name}`} /></td><td><span class="asset-title"><i class="file-type">{doc.name.split(".").at(-1)?.toUpperCase()}</i><span><strong>{doc.name}</strong><small>{doc.id} · {doc.size}</small></span></span></td><td><span class="category-chip">{doc.category}</span></td><td>{doc.owner}</td><td><span class:list={["status-chip", doc.status === "分析中" && "processing", doc.status === "待复核" && "warning", doc.status === "已脱敏" && "secure"]}>{doc.status === "分析中" && <i class="spinner"></i>}{doc.status}</span></td><td>{doc.updated}</td><td><button class="icon-btn small" aria-label="文档操作">•••</button></td></tr>)}</tbody></table></div>
              <div class="table-footer"><span>共 148 份文档 · 当前显示 5 份</span><div><button disabled>‹</button><button class="is-current">1</button><button>2</button><button>3</button><button>…</button><button>30</button><button>›</button></div></div>
            </article>
          </section>

          <section class="view" id="view-analysis" data-view="analysis" hidden>
            <div class="page-intro"><div><p class="eyebrow">ANALYSIS STUDIO</p><h1>智能分析工作室</h1><p>以业务 Schema 驱动分类、提取和证据校验。</p></div><div class="intro-actions"><span class="health-chip" id="provider-health-chip"><i></i> 本地演示就绪</span><button class="primary-btn" data-open-intake>＋ 新分析</button></div></div>
            <article class="analysis-hero panel">
              <div class="analysis-meta"><span class="file-glyph large" id="analysis-file-type">PDF</span><div><span class="status-chip processing"><i class="spinner"></i><span id="analysis-status-label">运行中</span></span><h2>星穹推理引擎技术白皮书 V3.2.pdf</h2><p id="analysis-meta-copy">JOB-240809-018 · 技术白皮书 · 326 页 · 创建于 09:24</p></div><div class="analysis-score"><span id="analysis-progress-ring" style="--progress:72"><strong id="analysis-progress-number">72%</strong></span><small>总体进度</small></div></div>
              <div class="analysis-stage-grid" id="analysis-stage-grid">
                <article class="analysis-stage is-complete" data-threshold="18"><span>01</span><div><b>MinerU 版式解析</b><small>326 页 · 1,842 个内容块</small></div><strong>✓</strong></article>
                <article class="analysis-stage is-complete" data-threshold="36"><span>02</span><div><b>StructBERT 分类</b><small>技术白皮书 · 置信度 98.4%</small></div><strong>✓</strong></article>
                <article class="analysis-stage is-complete" data-threshold="62"><span>03</span><div><b>Schema IP 提取</b><small>18 项资产 · 74 个字段</small></div><strong>✓</strong></article>
                <article class="analysis-stage is-active" data-threshold="82"><span>04</span><div><b>多模型交叉校验</b><small>正在核验 3 个低置信字段</small></div><strong class="stage-pulse"></strong></article>
                <article class="analysis-stage" data-threshold="100"><span>05</span><div><b>Wiki 与关系生成</b><small>等待上一步完成</small></div><strong>—</strong></article>
              </div>
              <div class="analysis-actions"><span id="analysis-live-text" role="status">预计剩余 4 分 12 秒</span><button class="secondary-btn">查看运行日志</button><button class="primary-btn" id="advance-analysis" data-testid="advance-analysis">推进演示任务</button></div>
            </article>
            <article class="panel real-analysis-results" id="real-analysis-results" data-testid="real-analysis-results" hidden>
              <div class="panel-head real-result-head"><div><span class="kicker">LIVE PROVIDER RESULT</span><h2>真实服务分析结果</h2><p>MinerU 原文解析与 DeepSeek 结构化推理已形成同一条可审计证据链。</p></div><div class="provider-badges"><span><i></i> MinerU LIVE</span><span><i></i> DeepSeek LIVE</span></div></div>
              <div class="real-provider-grid">
                <div><small>MinerU 任务</small><strong id="real-provider-id" data-testid="real-provider-id">—</strong><span id="real-parser-model">—</span></div>
                <div><small>DeepSeek 模型</small><strong id="real-model-name" data-testid="real-model-name">—</strong><span id="real-response-id">—</span></div>
                <div><small>Token 用量</small><strong id="real-token-usage" data-testid="real-token-usage">—</strong><span>提示词 + 生成</span></div>
                <div><small>解析完整性</small><strong id="real-markdown-count">—</strong><span id="real-markdown-hash">SHA-256 —</span></div>
              </div>
              <div class="real-content-grid">
                <section class="real-summary"><span class="kicker">DOCUMENT INTELLIGENCE</span><h3 id="real-document-title">—</h3><p id="real-document-summary">—</p><div class="real-wiki"><h4>Wiki 核心机制</h4><p id="real-wiki-mechanism">—</p></div><div class="real-risk-list" id="real-risk-list"></div></section>
                <section><div class="result-section-head"><div><span class="kicker">EXTRACTED ASSETS</span><h3>结构化 IP 资产</h3></div><span id="real-asset-count">0 项</span></div><div class="real-asset-list" id="real-asset-list" data-testid="real-asset-list"></div></section>
              </div>
              <section class="real-evidence"><div class="result-section-head"><div><span class="kicker">PROVENANCE</span><h3>MinerU → DeepSeek 原文证据</h3></div><span>逐字引用</span></div><div id="real-source-quotes" data-testid="real-source-quotes"></div></section>
              <div class="publication-toolbar" aria-live="polite"><div class="provider-boundary" id="provider-boundary-status"><span>DATA BOUNDARY</span><strong>本地网关保管密钥；文档经授权发送 MinerU，解析文本发送 DeepSeek</strong></div><div class="publication-action"><span class="status-chip warning" id="publication-status">待人工复核</span><button class="primary-btn" id="publish-analysis" data-testid="publish-analysis" disabled>复核并发布到资产库 →</button></div></div>
            </article>
            <div class="analysis-grid">
              <article class="panel source-preview"><div class="panel-head"><div><span class="kicker">SOURCE DOCUMENT</span><h2>原文定位</h2></div><span class="page-chip">第 48 / 326 页</span></div><div class="paper-page"><div class="paper-heading">3.2 稀疏专家路由机制</div><p>在大规模推理负载下，传统静态路由难以兼顾吞吐与专家负载均衡。本方案提出一种基于实时 token 密度的动态路由机制……</p><p class="source-highlight" data-open-provenance>系统在每个推理批次开始前计算专家负载向量，并通过二阶平滑窗口预测下一周期的拥塞概率。路由器依据预测结果动态调整 Top‑K 专家集合。<span>[S-048-03]</span></p><p>实验表明，在相同硬件条件下，方案将 P99 延迟降低 31.6%，并将专家间负载方差控制在 0.08 以内。</p></div></article>
