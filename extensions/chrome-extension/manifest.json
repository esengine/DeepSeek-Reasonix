{
  "manifest_version": 3,
  "name": "Reasonix Browser Relay",
  "version": "1.0.0",
  "description": "Bridge between Reasonix AI and your browser. Lets AI agents navigate, click, type, and read pages through your existing Chrome session.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "debugger",
    "activeTab",
    "storage",
    "tabs"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Reasonix Browser Relay",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}