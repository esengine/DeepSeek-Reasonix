# DeepSeek-Reasonix 本地开发环境隔离
# direnv allow 后生效

# Go 环境隔离
export GOPATH="$PWD/.direnv/gopath"
export GOCACHE="$PWD/.direnv/gocache"
export GOMODCACHE="$PWD/.direnv/gomodcache"
export GOBIN="$PWD/.direnv/bin"
# 开发构建 (make build → ./bin/) 优先于系统版本
export PATH="$PWD/bin:$GOBIN:$PATH"

# Node/pnpm 环境隔离
export NODE_ENV="development"
export PNPM_HOME="$PWD/.direnv/pnpm"
export PATH="$PNPM_HOME:$PATH"

# 代理（按需启用）
export http_proxy="http://127.0.0.1:10808"
export https_proxy="http://127.0.0.1:10808"
export no_proxy="localhost,127.0.0.1"

# Git 代理（仅本项目）
export GIT_CONFIG_COUNT=2
export GIT_CONFIG_KEY_0="http.proxy"
export GIT_CONFIG_VALUE_0="http://127.0.0.1:10808"
export GIT_CONFIG_KEY_1="https.proxy"
export GIT_CONFIG_VALUE_1="http://127.0.0.1:10808"

# 项目标识
export REASONIX_PROJECT_ROOT="$PWD"

# 隔离 XDG 目录（防止测试读到全局配置）
export XDG_STATE_HOME="$PWD/.direnv/xdg-state"
export XDG_CONFIG_HOME="$PWD/.direnv/xdg-config"
mkdir -p "$XDG_STATE_HOME" "$XDG_CONFIG_HOME"

echo "✓ Reasonix dev env loaded (GOPATH=$GOPATH)"
